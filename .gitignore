# SwiftPM build products. Package.resolved is deliberately committed: this is an application,
# so pinned dependency versions are what make a measured baseline reproducible.
.build/
.swiftpm/

# Downloaded WhisperKit models (regenerated on demand, ~1.5 GB)
.models/

# Intermediate fixture renders from Scripts/make-fixtures.sh
.fixture-build/

# The AMI corpus download (40 MB of audio plus 22 MB of annotations), fetched on demand by
# Scripts/make-ami-fixtures.sh. The three fixtures cut from it are committed, so a clean
# checkout measures the same audio without the download.
.corpora/

# Generated by `make test` — regenerate with `make test`, don't hand-edit. The committed
# reference point is evaluations/baseline.json, not this.
reports/

# Xcode
*.xcodeproj
xcuserdata/
.DS_Store

# Python bytecode from `python -m py_compile` on the Scripts/ helpers
__pycache__/

# The iOS app: generated Info.plist, and Scripts/sim.sh build output, screenshots and pulled diagnostics
App/Generated/
.sim/
